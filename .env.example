# ─── Pipeline timing (shared across IEP1, IEP2, IEP3) ─────────────────────────
# Required — no default in any service. All three services must use the same value.
# Mismatch causes IEP3 to never assemble a complete batch (silent failure).
WINDOW_SECONDS=60

# ─── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=retailvision
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=retailvision

# EEP runtime URL — SQLAlchemy asyncpg dialect (postgresql+asyncpg://).
DATABASE_URL_EEP=postgresql+asyncpg://retailvision:REPLACE_ME@pgbouncer:5432/retailvision

# IEP2 + IEP3 runtime URL — plain asyncpg (postgresql://, no +asyncpg prefix).
DATABASE_URL_SERVER=postgresql://retailvision:REPLACE_ME@pgbouncer:5432/retailvision

# Alembic migration URL — psycopg2, connects directly to postgres (bypasses PgBouncer).
ALEMBIC_DATABASE_URL=postgresql+psycopg2://retailvision:REPLACE_ME@postgres:5432/retailvision

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── S3 / MinIO ────────────────────────────────────────────────────────────────
# MinIO console: http://localhost:9001
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME
S3_BUCKET=retailvision

# ─── Auth ──────────────────────────────────────────────────────────────────────
# Required — no default. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_ME

# ─── Admin bootstrap (optional) ────────────────────────────────────────────────
# If BOTH are set and no super-admin exists, EEP seeds one super-admin on startup
# (idempotent). Treat the password like JWT_SECRET. Leave blank to use the CLI:
#   python -m app.cli create-admin --email ops@example.com --password '...' --name Ops
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ─── SMTP (optional — only needed for email features) ──────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Alertmanager SMTP password — injected into alertmanager.yml via env var expansion.
ALERTMANAGER_SMTP_PASSWORD=

# ─── Feature flags ─────────────────────────────────────────────────────────────
# Set to true only in docker-compose.dev.yml — never in CI/staging/production.
DEBUG_MODE=false

# ─── Docker image tags ─────────────────────────────────────────────────────────
IEP1_IMAGE=retailvision-iep1:latest
IEP2_IMAGE=retailvision-iep2:latest
DOCKER_NETWORK=retail-edge_default

# ─── Per-camera worker config (IEP1) ───────────────────────────────────────────
# One container per camera. Set per-instance via docker-compose env or CLI.
STORE_ID=00000000-0000-0000-0000-000000000001
CAMERA_ID=cam-01
# RTSP_URL — no default, must be set explicitly.
# From host (mediamtx running locally): rtsp://host.docker.internal:8554/test
# From container (mediamtx as Docker service): rtsp://mediamtx:8554/test
RTSP_URL=rtsp://host.docker.internal:8554/test
TARGET_FPS=5.0

# ─── Edge Agent ────────────────────────────────────────────────────────────────
EEP_GRPC_URL=eep:50051
AGENT_VERSION=0.1.0

# ─── IEP3 Reconciliation ───────────────────────────────────────────────────────
# Required — IEP3 will not start without this.
# Comma-separated physical_cameras.id UUIDs for the store being reconciled.
EXPECTED_CAMERAS=

# Seconds to wait for all cameras before partial reconciliation fires.
COORDINATOR_TIMEOUT_S=120

# ReID cosine similarity threshold [0, 1]. Higher = stricter.
REID_THRESHOLD=0.75

# Maximum plausible walking speed in m/s for spatial gate.
MAX_SPEED_MPS=1.5

# ReID embedding dimension. Must match IEP2 ReID model output (resnet50_msmt17 → 2048).
EMBEDDING_DIM=2048

# Position selection weights. Must sum to 1.0.
SELECTION_WEIGHT_AREA=0.7
SELECTION_WEIGHT_CONFIDENCE=0.3

# GlobalID grace period before LOST → EXITED transition (seconds).
GRACE_SECONDS=300.0

# Fallback frame resolution for scoring normalization.
DEFAULT_FRAME_WIDTH=1920
DEFAULT_FRAME_HEIGHT=1080

# ─── LLM API Keys (IEP6) ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Monitoring ────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=REPLACE_ME

# Metrics exposure ports (prometheus_client side HTTP server per daemon).
# IEP1/IEP2 already scraped on 9200/9201; IEP4 daemon scraped on 8004.
IEP4_METRICS_PORT=8004
# IEP5 is a one-shot Job — it PUSHES to the Pushgateway instead of being scraped.
# Leave blank in a dev run without a gateway to skip the push.
IEP5_PUSHGATEWAY_URL=pushgateway:9091

# ─── Robustness: inference deadlines (IEP2 → yolo/reid ZMQ) ─────────────────────
# A stalled inference service must never hang a camera. On deadline the frame
# falls back to [] (detect) / None (reid); the batch budget scales with frames.
YOLO_REQUEST_TIMEOUT_S=5.0
YOLO_BATCH_PER_FRAME_S=0.1
REID_REQUEST_TIMEOUT_S=3.0

# Bounded SMTP send so a wedged mail server cannot stall the IEP4 cycle (also EEP).
SMTP_TIMEOUT_S=10.0

# ─── Robustness: EEP external-boundary timeouts (app/core/resilience.py) ────────
# Bounded waits so a slow Postgres/Redis/S3 can never hang an EEP request worker.
DB_STATEMENT_TIMEOUT_S=30.0     # asyncpg client-side statement timeout
S3_CONNECT_TIMEOUT_S=3.0
S3_READ_TIMEOUT_S=10.0
S3_MAX_ATTEMPTS=3               # botocore native retries (NOT tenacity)
REDIS_SOCKET_TIMEOUT_S=2.0
REDIS_CONNECT_TIMEOUT_S=2.0

# ─── Robustness: EEP rate limiting + request-size limits (slowapi) ──────────────
# Global per-IP default on every route; tighter on auth/password-reset. Redis-
# backed (shared across EEP replicas) + fail-open. Storage defaults to REDIS_URL.
RATE_LIMIT_GLOBAL=120/minute
RATE_LIMIT_AUTH=10/minute       # login, register, refresh
RATE_LIMIT_PWRESET=5/minute     # forgot/reset password (email amplification)
RATE_LIMIT_WRITE=60/minute
# RATE_LIMIT_STORAGE_URI=redis://...   # override; else REDIS_URL, else memory://
MAX_REQUEST_BYTES=15000000      # coarse body ceiling (~15MB)
MAX_IMAGE_UPLOAD_BYTES=10000000 # floor-plan / camera-frame image cap (~10MB)
MAX_XML_UPLOAD_BYTES=2000000    # calibration XML cap (~2MB)
