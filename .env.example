# ─── Database ──────────────────────────────────────────────────────────────────
# For local dev (services run on host, infrastructure via Docker):
#   postgresql+asyncpg://retailvision:retailvision_dev@localhost:5432/retailvision
# For Docker Compose (all in containers):
#   postgresql+asyncpg://retailvision:retailvision_dev@postgres:5432/retailvision
POSTGRES_USER=retailvision
POSTGRES_PASSWORD=retailvision_dev
POSTGRES_DB=retailvision
DATABASE_URL=postgresql+asyncpg://retailvision:retailvision_dev@localhost:5432/retailvision

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── S3 / MinIO ────────────────────────────────────────────────────────────────
# MinIO console available at http://localhost:9001
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=retailvision
S3_SECRET_KEY=retailvision_dev
S3_BUCKET=retailvision

# ─── Per-camera worker config (IEP1 + IEP2) ───────────────────────────────────
# One container per camera. Override per-instance via docker-compose env or CLI.
STORE_ID=store-01
CAMERA_ID=cam-01
# RTSP_URL — no default, must be set explicitly.
# From host (mediamtx running locally): rtsp://host.docker.internal:8554/test
# From container (mediamtx as Docker service): rtsp://mediamtx:8554/test
RTSP_URL=rtsp://host.docker.internal:8554/test
TARGET_FPS=5.0
BATCH_WINDOW_SECONDS=30.0

# ─── LLM API Keys (Milestone 6) ────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Service Ports ─────────────────────────────────────────────────────────────
EEP_PORT=8000
IEP1_PORT=8001
IEP2_PORT=8002
IEP3_PORT=8003
IEP4_PORT=8004
IEP5_PORT=8005

# ── IEP3 Reconciliation ───────────────────────────────────────────────────────
# Comma-separated camera_id strings (physical_cameras.id UUIDs) for this store.
# Must match the camera_ids flowing through tracking_history.
# Required — IEP3 will not start without this.
EXPECTED_CAMERAS=

# Seconds to wait for all cameras before partial reconciliation fires.
# Default: 120 (2× the 60s batch window). Increase for high-latency networks.
COORDINATOR_TIMEOUT_S=120

# ReID cosine similarity threshold. Range [0, 1]. Higher = stricter matching.
# Default: 0.75 (matches IEP2 within-camera threshold).
REID_THRESHOLD=0.75

# Maximum plausible walking speed in meters/second for spatial gate.
# Default: 1.5 m/s (~comfortable walking pace).
MAX_SPEED_MPS=1.5

# OSNet embedding dimension. Must match IEP2's ReID model output.
# Default: 512.
EMBEDDING_DIM=512

# Position selection weights. Must sum to 1.0.
SELECTION_WEIGHT_AREA=0.7
SELECTION_WEIGHT_CONFIDENCE=0.3

# GlobalID grace period in seconds before LOST → EXITED transition.
# Default: 300 (5 × 60s batch windows).
GRACE_SECONDS=300.0

# Fallback frame resolution when physical_cameras.stream_width/height
# and camera_configs.video_width/height are both NULL (RTSP without
# prior IEP2 run, or dev mode). Used only for scoring normalization.
DEFAULT_FRAME_WIDTH=1920
DEFAULT_FRAME_HEIGHT=1080
