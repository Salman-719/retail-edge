# ─── Database ──────────────────────────────────────────────────────────────────
# For local dev (services run on host, infrastructure via Docker):
#   postgresql+asyncpg://retailvision:retailvision_dev@localhost:5432/retailvision
# For Docker Compose (all in containers):
#   postgresql+asyncpg://retailvision:retailvision_dev@postgres:5432/retailvision
POSTGRES_USER=retailvision
POSTGRES_PASSWORD=retailvision_dev
POSTGRES_DB=retailvision
DATABASE_URL=postgresql+asyncpg://retailvision:retailvision_dev@localhost:5432/retailvision

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── S3 / MinIO ────────────────────────────────────────────────────────────────
# MinIO console available at http://localhost:9001
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=retailvision
S3_SECRET_KEY=retailvision_dev
S3_BUCKET=retailvision

# ─── LLM API Keys (Milestone 6) ────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Service Ports ─────────────────────────────────────────────────────────────
EEP_PORT=8000
IEP1_PORT=8001
IEP2_PORT=8002
IEP3_PORT=8003
IEP4_PORT=8004
IEP5_PORT=8005
