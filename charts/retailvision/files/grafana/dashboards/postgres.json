    },
    {
      "type": "stat",
      "title": "Connection utilisation",
      "datasource": {
        "type": "prometheus",
        "uid": "DS_PROMETHEUS"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.6
              },
              {
                "color": "red",
                "value": 0.85
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "DS_PROMETHEUS"
          },
          "expr": "sum(pg_stat_activity_count{datname=\"retailvision\"}) / pg_settings_max_connections",
          "legendFormat": "Utilisation",
          "refId": "A"
        }
      ]
    },
