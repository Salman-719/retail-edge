# x86 dev build (no Jetson/TRT/ARM). Defaults to CPU-only PyTorch.
# For an NVIDIA GPU, override TORCH_INDEX_URL to a CUDA wheel index — see
# docker-compose.gpu.yml. Do NOT use in production — use Dockerfile (Jetson TRT).

FROM python:3.11-slim

WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Torch wheel index. CPU by default; the GPU overlay sets this to a CUDA index
# (e.g. https://download.pytorch.org/whl/cu121). The CUDA wheel bundles its own
# CUDA runtime, so the host needs only the NVIDIA driver + Container Toolkit.
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir \
    torch==2.3.1 \
    torchvision==0.18.1 \
    --index-url ${TORCH_INDEX_URL}

# Install remaining deps (torch already satisfied above; pip will not reinstall it).
COPY services/yolo_service/requirements.dev.txt requirements.dev.txt
RUN pip install --no-cache-dir -r requirements.dev.txt

# Copy service source — mirrors the module path services.yolo_service.*
COPY services/yolo_service/ services/yolo_service/
RUN touch services/__init__.py

# Bake in RT-DETR-x weights so the container needs no internet access at runtime.
# ultralytics downloads rtdetr-x.pt into the CWD (/workspace) on first reference.
RUN python -c "from ultralytics import RTDETR; RTDETR('rtdetr-x.pt')"

CMD ["python", "-m", "services.yolo_service.service_dev"]
