# x86 / Intel CPU dev build — no TRT, no pycuda, no ARM base image.
# Build context: ./services/osnet_service (no files needed from repo root).
# Do NOT use this in staging or production — use Dockerfile (Jetson TRT).

FROM python:3.11-slim

WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install CPU-only torch + torchvision before other deps.
RUN pip install --no-cache-dir \
    torch==2.3.1 \
    torchvision==0.18.1 \
    --index-url https://download.pytorch.org/whl/cpu

COPY requirements.dev.txt .
RUN pip install --no-cache-dir -r requirements.dev.txt

# Pre-download ResNet-18 weights at build time — avoids runtime internet dependency.
RUN python -c "import torchvision.models as m; m.resnet18(weights=m.ResNet18_Weights.DEFAULT)"

# Copy service source — mirrors the module path services.osnet_service.*
COPY . services/osnet_service/
RUN touch services/__init__.py

CMD ["python", "-m", "services.osnet_service.service_dev"]
