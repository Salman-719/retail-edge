POSTGRES_USER=retailvision
POSTGRES_PASSWORD=retailvision_dev
POSTGRES_DB=retailvision

# For local Python (outside Docker):
# DATABASE_URL=postgresql://retailvision:retailvision_dev@localhost:5432/retailvision

# For Docker Compose (set automatically via docker-compose.yml — no need to set here):
# DATABASE_URL=postgresql://retailvision:retailvision_dev@postgres:5432/retailvision

# Vision Debug Console dev server:
#   docker compose --profile dev up -d iep2_dev
# The frontend page at /dev/vision connects to VITE_IEP2_DEV_API_URL (default: http://localhost:8002).
