# Copy to .env and adjust for the machine that will publish camera streams.

# Host directory mounted into the publisher container as /videos.
# The default points at this repo's testing videos when run from camera-simulator/.
VIDEO_ROOT=../testing-data

# Local CSV mounted as the stream config.
STREAMS_FILE_HOST=./streams.csv

# Port exposed on the simulator laptop/server.
RTSP_PORT=8554

# Optional: force the host/IP printed by scripts/start.sh.
# Leave empty to auto-detect the LAN IP.
SIMULATOR_HOST=

# copy is fastest and preserves the original video codec.
# h264 re-encodes to a broadly compatible low-latency RTSP stream.
PUBLISH_MODE=copy

# Used when PUBLISH_MODE=h264, and always used for still-image sources.
OUTPUT_FPS=15
OUTPUT_WIDTH=1280

FFMPEG_LOGLEVEL=warning
RESTART_DELAY_SECONDS=2

MEDIAMTX_IMAGE=bluenviron/mediamtx:latest
FFMPEG_IMAGE=jrottenberg/ffmpeg:4.4-alpine
