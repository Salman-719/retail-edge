{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retailvision.local/contracts/vision-events/v1/global_identity_observed.schema.json",
  "title": "GlobalIdentityObservedEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "store_id",
    "version_id",
    "section_id",
    "camera_id",
    "camera_config_id",
    "source_ts",
    "sequence",
    "local_track_id",
    "global_person_id",
    "bbox",
    "confidence",
    "match_type",
    "gallery_version",
    "frame_ref"
  ],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "vision.global_identity_observed.v1" },
    "schema_version": { "const": "1.0" },
    "store_id": { "type": "string", "format": "uuid" },
    "version_id": { "type": "string", "format": "uuid" },
    "section_id": { "type": "string", "format": "uuid" },
    "camera_id": { "type": "string", "format": "uuid" },
    "camera_config_id": { "type": "string", "format": "uuid" },
    "source_ts": { "type": "string", "format": "date-time" },
    "sequence": { "type": "integer", "minimum": 0 },
    "local_track_id": { "type": "integer", "minimum": 0 },
    "global_person_id": { "type": "string" },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number" }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "match_type": {
      "type": "string",
      "enum": [
        "new_identity",
        "existing_local_track",
        "local_id_switch_recovered",
        "cross_camera_reid",
        "identity_merged"
      ]
    },
    "match_similarity": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "match_distance": { "type": ["number", "null"], "minimum": 0 },
    "gallery_version": { "type": "integer", "minimum": 1 },
    "frame_ref": { "type": "object", "additionalProperties": true }
  }
}
