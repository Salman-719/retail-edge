{
  "title": "RetailVision -- Business Metrics (IEP5)",
  "uid": "retailvision-business",
  "tags": ["retailvision", "business", "iep5", "analytics"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 38,
  "description": "Customer footfall, dwell time, and conversion signals from IEP5 analytics. Panels show 'No data' until IEP5 is active and processing reconciled GlobalIDs.",
  "templating": {"list": []},
  "panels": [
    {
      "type": "row",
      "title": "Customer Footfall",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 1
    },
    {
      "type": "stat",
      "title": "Unique customers (last hour)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 1},
      "id": 2,
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "iep5_unique_customers_total",
          "legendFormat": "Unique customers",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Avg dwell time (seconds)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 1},
      "id": 3,
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 300}, {"color": "red", "value": 600}]}
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "iep5_avg_dwell_time_seconds",
          "legendFormat": "Avg dwell",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Active visitors (now)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 1},
      "id": 4,
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 50}, {"color": "red", "value": 100}]}
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "iep5_active_visitors",
          "legendFormat": "Active visitors",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Footfall rate (visitors/hour)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 1},
      "id": 5,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "rate(iep5_unique_customers_total[1h]) * 3600",
          "legendFormat": "Visitors/hour",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Footfall over time (unique customers per 5m window)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 6},
      "id": 6,
      "options": {"tooltip": {"mode": "single"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"fillOpacity": 15}}, "overrides": []},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "increase(iep5_unique_customers_total[5m])",
          "legendFormat": "New customers (5m)",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "iep5_active_visitors",
          "legendFormat": "Active visitors",
          "refId": "B"
        }
      ]
    },
    {
      "type": "row",
      "title": "Dwell Time Analysis",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14},
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Dwell time p50 / p95 over time",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 14, "x": 0, "y": 15},
      "id": 11,
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "custom": {"fillOpacity": 5}}, "overrides": []},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "histogram_quantile(0.50, sum by (le) (rate(iep5_dwell_time_seconds_bucket[5m])))",
          "legendFormat": "p50 dwell",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "histogram_quantile(0.95, sum by (le) (rate(iep5_dwell_time_seconds_bucket[5m])))",
          "legendFormat": "p95 dwell",
          "refId": "B"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Short visits (< 30s)",
      "description": "Visitors who left in under 30 seconds -- possible browsing without engagement.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 4, "w": 5, "x": 14, "y": 15},
      "id": 12,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "iep5_dwell_time_seconds_bucket{le=\"30\"}",
          "legendFormat": "< 30s",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Long visits (> 5min)",
      "description": "Visitors who stayed over 5 minutes -- high engagement signal.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 4, "w": 5, "x": 19, "y": 15},
      "id": 13,
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "iep5_unique_customers_total - iep5_dwell_time_seconds_bucket{le=\"300\"}",
          "legendFormat": "> 5min",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Zone Heatmap & Conversion",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 23},
      "id": 20
    },
    {
      "type": "timeseries",
      "title": "Zone occupancy over time",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 14, "x": 0, "y": 24},
      "id": 21,
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "iep5_zone_visitors{zone_id=~\".+\"}",
          "legendFormat": "Zone {{zone_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Visitors per zone (now)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 10, "x": 14, "y": 24},
      "id": 22,
      "options": {
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "displayMode": "gradient"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 10}, {"color": "red", "value": 25}]}
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "iep5_zone_visitors{zone_id=~\".+\"}",
          "legendFormat": "{{zone_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Conversion events over time",
      "description": "IEP5 conversion events (defined per business use-case, e.g. entry into checkout zone).",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 32},
      "id": 23,
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"fillOpacity": 20}}, "overrides": []},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "rate(iep5_conversion_events_total[5m]) * 60",
          "legendFormat": "{{event_type}} /min",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "IEP5 Service Health",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 40},
      "id": 30
    },
    {
      "type": "timeseries",
      "title": "IEP5 HTTP request rate",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 41},
      "id": 31,
      "options": {"tooltip": {"mode": "multi"}},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "rate(http_requests_total{job=\"iep5\"}[1m])",
          "legendFormat": "{{method}} {{handler}} {{status_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "IEP5 HTTP latency p95",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 41},
      "id": 32,
      "options": {"tooltip": {"mode": "multi"}},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket{job=\"iep5\"}[5m])))",
          "legendFormat": "p95 {{handler}}",
          "refId": "A"
        }
      ]
    }
  ],
  "time": {"from": "now-1h", "to": "now"}
}
