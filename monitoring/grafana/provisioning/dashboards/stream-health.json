      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "IEP2 BoTSORT track age p50 / p95 (frames) — ML signal",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.50, sum by (le, camera_id) (rate(iep2_track_age_frames_bucket[5m])))",
          "legendFormat": "p50 {{camera_id}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum by (le, camera_id) (rate(iep2_track_age_frames_bucket[5m])))",
          "legendFormat": "p95 {{camera_id}}",
          "refId": "B"
        }
      ]
