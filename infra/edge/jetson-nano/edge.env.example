# Copy to /etc/retail-edge/iaip1-edge.env on the Jetson.
# Never commit real credentials.

IEP1_EDGE_ENV_FILE=/etc/retail-edge/iaip1-edge.env

# IAIP1 boots and immediately asks EEP for active camera topology.
IEP1_AUTO_START_STORE_ID=00000000-0000-0000-0000-000000000001
IEP1_AUTO_START_RUN_ID=edge-store-0001
IEP1_AUTO_START_SAMPLE_RATE_FPS=2.0
# Leave empty for continuous production. Set a number only for smoke tests.
IEP1_AUTO_START_MAX_FRAMES_PER_CAMERA=
IEP1_STREAM_RETRY_SECONDS=10

# More reliable RTSP reads through OpenCV/FFmpeg on store networks.
OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp

# EEP control plane.
EEP_BASE_URL=https://eep.example.com
VISION_INTERNAL_TOKEN=change-me

# Cloud event bus. Use PLAINTEXT only on a private lab network/VPN.
EVENT_BUS_BACKEND=kafka
VISION_EVENT_BOOTSTRAP_SERVERS=redpanda.example.com:9094
VISION_FRAME_REF_TOPIC=vision.frame_ref.v1
VISION_KAFKA_SECURITY_PROTOCOL=SASL_SSL
VISION_KAFKA_SASL_MECHANISM=SCRAM-SHA-256
VISION_KAFKA_SASL_USERNAME=edge-camera-writer
VISION_KAFKA_SASL_PASSWORD=change-me
VISION_KAFKA_CA_FILE=/etc/retail-edge/ca/cloud-kafka-ca.pem

# Frame storage. IAIP2 in the cloud must be able to read these s3:// frame refs.
IEP1_FRAME_STORAGE=s3
S3_ENDPOINT_URL=https://minio.example.com
S3_BUCKET=retailvision
S3_ACCESS_KEY=edge-camera-writer
S3_SECRET_KEY=change-me
# Optional for private/self-signed object-store CAs.
# AWS_CA_BUNDLE=/etc/retail-edge/ca/object-store-ca.pem

# Local fallback/debug only. Do not use filesystem refs when IAIP2 runs in cloud.
# IEP1_FRAME_STORAGE=filesystem
# IEP1_EVENT_LOG_DIR=/app/runtime/events

# Cloud IAIP2/IEP3 runtime defaults, shown here for consistency with store config.
# These are normally set in cloud/k8s, not on the IAIP1-only Jetson.
# GLOBAL_GALLERY_MAX_SIZE=6
