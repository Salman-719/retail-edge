        {
          "name": "1.1 Create Employee 1 (Cashier)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "const j = pm.response.json();",
            "pm.collectionVariables.set('employee_id_1', j.id);",
            "pm.test('name matches', () => pm.expect(j.name).to.eql('Alice Martin'));",
            "pm.test('role cashier', () => pm.expect(j.role).to.eql('cashier'));",
            "pm.test('is_active true', () => pm.expect(j.is_active).to.be.true);",
            "pm.test('enrollment_status pending', () => pm.expect(j.enrollment_status).to.eql('pending'));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/store/{{store_slug}}/employees",
            "body": { "mode": "raw", "raw": "{\"name\":\"Alice Martin\",\"role\":\"cashier\",\"employee_code\":\"EMP001\",\"phone\":\"+1-555-0101\",\"email\":\"alice@store.example\"}" }
