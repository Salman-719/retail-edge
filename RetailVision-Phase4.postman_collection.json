    {
      "name": "0. Setup",
      "item": [
        {
          "name": "0.1 Login as Owner",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('access_token', pm.response.json().access_token);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login",
            "body": { "mode": "raw", "raw": "{\"email\":\"{{owner_email}}\",\"password\":\"{{owner_password}}\"}" }
          }
        },
        {
          "name": "0.2 Get My Stores - set slug",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('store_slug', pm.response.json()[0].slug);"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/stores"
          }
        },
        {
          "name": "0.3 Get Section ID",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('section_id', pm.response.json()[0].id);"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/store/{{store_slug}}/sections"
          }
        }
      ]
    },
    {
